{
  "manifest_version": 3,
  "name": "Kaldora Thor Local Bridge",
  "version": "0.5.6",
  "browser_specific_settings": {
    "gecko": {"id": "thor-bridge@kaldora-thor.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personalCommunications", "websiteContent"]}},
    "gecko_android": {"strict_min_version": "142.0"}
  },
  "host_permissions": ["http://127.0.0.1/*", "https://play.kaldora.eu/*"],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [
    {"matches": ["https://play.kaldora.eu/*"], "js": ["game.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://play.kaldora.eu/*"], "js": ["content.js"], "run_at": "document_start"}
  ]
}
